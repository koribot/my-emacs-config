# Ignore everything
*
# Keep these specific files
!.gitignore
!init.el
!early-init.el
!package.default
!README.md
# Keep configs directory and all its contents
!configs/
!configs/**
# Keep package cache for reproducible installs
!package.lock/
!package.lock/**
# But ignore temp/backup files everywhere
**/*~
**/*.elc
**/*.backup
**/*.swp
**/.#*
**/#*#
**/auto-save-list/
org-persist
!help.org
