# Ignore everything
*
# Keep these specific files
!.gitignore
!init.el
!early-init.el
!extensions.txt
!extensions.lock
!README.md
# Keep configs directory and all its contents
!configs/
!configs/**
# Keep package cache for reproducible installs
!package-cache/
!package-cache/**
# But ignore temp/backup files everywhere
**/*~
**/*.elc
**/*.backup
**/*.swp
**/.#*
**/#*#
**/auto-save-list/
org-persist
